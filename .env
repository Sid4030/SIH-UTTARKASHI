# ==============================================================================
# BhuRakshak Multi-Hazard Intelligence Platform — Environment Configuration
# ==============================================================================

# --- Google Earth Engine (GEE) Configuration ---
# Your authenticated Google Cloud Project ID for Earth Engine API calls:
GEE_PROJECT_ID="gmp-demo-project-504127132"

# (Optional) Path to Service Account JSON key (Only needed for production/headless servers):
# GEE_SERVICE_ACCOUNT_JSON=""

# --- Local AI & LLM Configuration (Ollama) ---
# Active model: Meta Llama 3.1 (8B Parameters, Q4_K_M quantized)
OLLAMA_API_URL="http://localhost:11434/api/generate"
OLLAMA_MODEL="llama3.1:8b"
OLLAMA_TIMEOUT=0  # 0 or none = infinite timeout for local CPU inference
USE_OLLAMA="true"

# --- Platform & Server Configuration ---
PORT=8000
HOST="127.0.0.1"
ENVIRONMENT="development"
